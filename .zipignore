# Plugin Hub package excludes (path-prefix match, relative to plugin folder).
# Anything listed here is left out of QGIS_Plugin_Releases/<plugin>.zip even
# though it may live on disk for local development or runtime export.
#
# web/data is the runtime export sink for the QGIS publisher (DEM, basemap PNG,
# GeoJSON layers). It can balloon to >25 MB and the Hub rejects oversized zips.
# The .gitignore already keeps it out of git; this keeps it out of the zip too.
web/data

# Repository-only content, not part of the installed plugin.
#
# docs/user_guide.html IS shipped: dialog.py opens it as the offline guide, and
# it is self-contained -- it references no image or asset. Everything else under
# docs/ belongs to the published Pages site: the long reference manual, the
# landing-page redirect, the screenshot tool, and the 2.9 MB of screenshots it
# generates. No code path opens any of them.
web/data
docs/PLANX_3D_CITY_REFERENCE_MANUAL.html
docs/index.html
docs/build_screenshots.py
docs/ROADMAP.md
docs/assets
.github

# Benchmark harness (writes its own synthetic web/data; not used by the plugin).
tests/bench

# Viewer unit tests (node --test tests/js/*.test.mjs).
tests/js
