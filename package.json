{
  "name": "planx-3d-city-dev",
  "private": true,
  "description": "Development tooling for the PlanX 3D City viewer (not needed to use the plugin).",
  "type": "module",
  "scripts": {
    "lint": "eslint web/src tests/js tests/bench tests/visual tests/smoke",
    "typecheck": "tsc -p tsconfig.checkjs.json",
    "test": "node --test tests/js/*.test.mjs",
    "bench:data": "python3 tests/bench/make_bench_data.py --buildings 1000",
    "bench:check": "node tests/bench/check_bench.mjs",
    "visual": "node tests/visual/visual.mjs",
    "smoke": "node tests/smoke/smoke.mjs"
  },
  "devDependencies": {
    "eslint": "10.1.0",
    "playwright": "1.56.1",
    "typescript": "6.0.2"
  }
}
